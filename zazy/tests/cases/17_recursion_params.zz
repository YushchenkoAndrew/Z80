#include "inc/print.zh"
//> 6
//> 14
//> 255
//> 1000
uint16_t f3(uint16_t a, uint8_t b, uint16_t c) { return a + b + c; }
uint8_t f8(uint8_t a, uint8_t b, uint8_t c) { return a * 2 + b - c; }
uint16_t depth(uint16_t n) { return n == 0 ? 0 : 1 + depth(n - 1); }
void main() {
  pu(f3(1, 2, 3));
  pu(f8(5, 6, 2));
  pu(f8(255, 0, 255) + 255 - 255 + 0);
  pu(depth(1000));
}
