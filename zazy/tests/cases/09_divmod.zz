#include "inc/print.zh"
//> ok
//> ok
//> ok
// self checking: q * d + r == n and r < d, for constant and variable divisors
uint8_t bad8 = 0, bad16 = 0, badc = 0;
void chk8(uint8_t n, uint8_t d) {
  uint8_t q = n / d, r = n % d;
  if (r >= d || (uint16_t)q * d + r != n) bad8++;
}
void chk16(uint16_t n, uint8_t d) {
  uint16_t q = n / d, r = n % d;
  if (r >= d || q * d + r != n) bad16++;
}
void main() {
  for (uint16_t n = 0; n < 256; n += 17)
    for (uint8_t d = 1; d != 0; d += 11) chk8(n, d);
  puts(bad8 ? "BAD\n" : "ok\n");
  for (uint16_t n = 0; n < 65000; n += 4999)
    for (uint8_t d = 1; d != 0; d += 17) chk16(n, d);
  puts(bad16 ? "BAD\n" : "ok\n");
  // constant divisors, both the library path (< 128) and the generic path
  uint8_t x = 200; uint16_t y = 60000;
  if (x / 3 != 66 || x % 3 != 2 || x / 150 != 1 || x % 150 != 50 || x / 255 != 0 || x % 255 != 200) badc++;
  if (y / 7 != 8571 || y % 7 != 3 || y / 200 != 300 || y % 200 != 0 || y / 1000 != 60 || y % 1000 != 0) badc++;
  int16_t s = -1000;
  if (s / 7 != -142 || s % 7 != -6 || s / -3 != 333 || s % -3 != -1) badc++;
  puts(badc ? "BAD\n" : "ok\n");
}
