#include "inc/print.zh"
//> 5
//> 120
//> 55
//> 3
//> 9
uint8_t add(uint8_t a, uint8_t b) { return a + b; }
uint16_t fact(uint8_t n) { if (n <= 1) return 1; return n * fact(n - 1); }
uint16_t fib(uint8_t n) { return n < 2 ? n : fib(n - 1) + fib(n - 2); }
uint8_t max3(uint8_t a, uint8_t b, uint8_t c) { uint8_t m = a; if (b > m) m = b; if (c > m) m = c; return m; }
uint16_t sq(uint16_t x) { return x * x; }
void main() {
  pu(add(2, 3));
  pu(fact(5));
  pu(fib(10));
  pu(max3(1, 3, 2));
  pu(sq(3));
}
