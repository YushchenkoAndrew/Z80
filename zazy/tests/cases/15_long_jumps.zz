    t += 33; t ^= 0xE7; t = (t << 1) | (t >> 7);
    t += 34; t ^= 0xEE; t = (t << 1) | (t >> 7);
    t += 35; t ^= 0xF5; t = (t << 1) | (t >> 7);
    t += 36; t ^= 0xFC; t = (t << 1) | (t >> 7);
    t += 37; t ^= 0x03; t = (t << 1) | (t >> 7);
    t += 38; t ^= 0x0A; t = (t << 1) | (t >> 7);
