    t += 20; t ^= 0x8C; t = (t << 1) | (t >> 7);
    t += 21; t ^= 0x93; t = (t << 1) | (t >> 7);
    t += 22; t ^= 0x9A; t = (t << 1) | (t >> 7);
    t += 23; t ^= 0xA1; t = (t << 1) | (t >> 7);
    t += 24; t ^= 0xA8; t = (t << 1) | (t >> 7);
    t += 25; t ^= 0xAF; t = (t << 1) | (t >> 7);
    t += 26; t ^= 0xB6; t = (t << 1) | (t >> 7);
