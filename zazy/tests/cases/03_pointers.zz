#include "inc/print.zh"
//> 42
//> 43
//> 1000
//> 7
//> 3
void inc(uint8_t* p) { (*p)++; }
void set16(uint16_t* p, uint16_t v) { *p = v; }
void swap(uint8_t* a, uint8_t* b) { uint8_t t = *a; *a = *b; *b = t; }
void main() {
  uint8_t x = 42; uint8_t* px = &x;
  pu(*px);
  inc(px); pu(x);
  uint16_t w; set16(&w, 1000); pu(w);
  uint8_t p = 3, q = 7; swap(&p, &q); pu(p); pu(q);
}
