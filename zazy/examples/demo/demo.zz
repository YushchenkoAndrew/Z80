// Everything at once, runs under `zazy --bare` (output goes to port 0x00 through RST 0x10).
//   ./zazy --bare -o demo.z80 examples/demo/demo.zz
#include <zazy.zh>

#define MAX_ITEMS 4
#define SQUARE(x) ((x) * (x))

struct Item {
  uint8_t  id;
  uint16_t price;
  const uint8_t* name;
};

struct Item shop[MAX_ITEMS] = {
  {1, 250, "apple"},
  {2, 1200, "bread"},
  {3, 75, "salt"},
  {4, 3000, "cheese"},
};

uint16_t counter = 0;

void print_u16(uint16_t v) {
  uint8_t digits[5];
  uint8_t n = 0;
  do { digits[n++] = v % 10; v /= 10; } while (v);
  while (n) putc('0' + digits[--n]);
}

uint16_t total(struct Item* items, uint8_t n) {
  uint16_t sum = 0;
  for (uint8_t i = 0; i < n; i++) sum += items[i].price;
  return sum;
}

void show(struct Item* it) {
  puts(it->name);
  puts(": ");
  print_u16(it->price);
  putc('\n');
}

void main() {
  for (uint8_t i = 0; i < MAX_ITEMS; i++) show(&shop[i]);
  puts("total ");
  print_u16(total(shop, MAX_ITEMS));
  putc('\n');
  print_u16(SQUARE(12));
  putc('\n');
  asm { NOP }                       // raw asm is allowed anywhere
}
