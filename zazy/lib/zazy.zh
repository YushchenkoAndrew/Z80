// zazy.zh -- standard header, included automatically (disable with --no-stdlib).
//
// Everything here is an `extern` binding: no code is generated for it, the call goes
// straight into the hand written routines from the Z80 library (Init.z80, Lcd.z80,
// utils/*.z80 ...).  Register contracts are taken from the comments above each routine.
#pragma once

// ---- raw port access (compiled to IN / OUT, constant ports use the short form) -------
extern uint8_t inb(uint8_t port)              asm("$in");
extern void    outb(uint8_t port, uint8_t v)  asm("$out");

// ---- console (RST 0x10 = print char, RST 0x18 = print zero terminated string) --------
extern void putc(uint8_t c)         asm("RST 0x10", in(A),  clobber(AF, BC, DE, HL));
extern void puts(const uint8_t* s)  asm("RST 0x18", in(HL), clobber(AF, BC, DE, HL));

// ---- strings / numbers ---------------------------------------------------------------
extern void    str_print(const uint8_t* s) asm("@STR_PRINT", in(HL), clobber(AF, BC, DE));
extern void    print(const uint8_t* s)     asm("@PRINT",     in(HL), clobber(AF, BC, DE));
extern uint8_t bin_bcd(uint8_t v)          asm("@BIN_BCD",   in(A),  out(A), clobber(AF));
extern uint8_t bcd_bin(uint8_t v)          asm("@BCD_BIN",   in(A),  out(A), clobber(AF));
extern uint8_t reverse_bits(uint8_t v)     asm("@REVERSE",   in(A),  out(A), clobber(AF));
extern void    hex_display(uint8_t v)      asm("@HEX",       in(A),  clobber(AF));

// ---- LCD -----------------------------------------------------------------------------
extern void lcd_init()                     asm("_LCD_INIT",  clobber(AF));
extern void lcd_clear()                    asm("_LCD_CLEAR", clobber(AF));
extern void lcd_putc(uint8_t c)            asm("@LCD_OUT",   in(A), clobber(AF));
extern void lcd_cmd(uint8_t cmd)           asm("@LCD_EXEC",  in(A), clobber(AF));
extern void lcd_new_line()                 asm("_LCD_NEW_LINE", clobber(AF));

// ---- event loop ----------------------------------------------------------------------
// queue a task for the event loop (needs EventLoop.z80 in your program); priority as in Defs.z80
typedef void (*task_t)(void);
extern void event_push(uint8_t priority, task_t task) asm("_EVENT_PUSH", in(A, HL), clobber(AF));
